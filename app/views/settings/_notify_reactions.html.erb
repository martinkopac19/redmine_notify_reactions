<p>
  <label>
    <%= hidden_field_tag 'settings[enabled]', '0' %>
    <%= check_box_tag 'settings[enabled]', '1', settings['enabled'].to_s != '0' %>
    <%= l(:nr_setting_enabled) %>
  </label>
</p>

<p style="color:#888; margin-top:4px;"><%= l(:nr_settings_hint) %></p>

<% unless Setting.reactions_enabled? %>
  <p class="warning"><%= l(:nr_reactions_disabled) %></p>
<% end %>
